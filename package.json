{
  "name": "live-tv-kayralrics-windows",
  "productName": "Live TV",
  "version": "1.0.0",
  "description": "World live television with source fallback and favorites — kayralrics.com",
  "private": true,
  "main": "main.cjs",
  "author": "kayralrics.com",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run vendor && electron .",
    "vendor": "node scripts/prepare-assets.cjs",
    "postinstall": "node scripts/prepare-assets.cjs",
    "verify": "node scripts/verify.cjs",
    "dist:win": "npm run vendor && npm run verify && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "hls.js": "1.7.4",
    "dashjs": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.kayralrics.livetv.windows",
    "productName": "Live TV",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "web/**/*",
      "assets/live-tv.png",
      "package.json",
      "!web/vendor/.gitkeep"
    ],
    "win": {
      "icon": "assets/live-tv.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Live TV",
      "artifactName": "Live-TV-Setup-${version}-${arch}.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "Live-TV-Portable-${version}-${arch}.${ext}"
    }
  }
}
